# Publication allowlist: only the active prototype and review material are versioned.
/*
!/.gitignore
!/README.md
!/FONTS.md
!/QA.md
!/THIRD_PARTY_NOTICES.md
!/requirements.txt
!/index.html
!/app-v2.mjs
!/core.mjs
!/page-layout.mjs
!/parse_text.mjs
!/layout.css
!/epub-reader.css
!/server.py
!/book_import.py
!/pdf_enhancement.py
!/paths.py
!/normalize-headings.lua
!/start.command
!/indexing-flow.drawio
!/indexing-flow.drawio.svg
!/native/
/native/*
!/native/OCR.swift
!/native/Palm.swift
!/scripts/
!/tests/
/tests/*
!/tests/core.test.mjs
!/tests/layout.test.mjs
!/tests/adapters_test.py
!/tests/pipeline_test.py
!/tests/demo_test.py
!/tests/page-turn.test.mjs
!/docs/
!/assets/
/assets/*
!/assets/favicon.svg
!/assets/fonts/
!/assets/vendor/

# Private libraries, caches, earlier experiments and original screenshots stay local.
/data/
/demo-data/
/tmp/
/qa/
/private-docs/
.venv/
__pycache__/
*.py[cod]
.env
.env.*
*.pem
*.key
.DS_Store
._*
